msgstr "Сервис не подтвердил запрос переиндексации."

#: src/Api.php:137
msgid "The service returned an invalid list."
msgstr "Сервис вернул некорректный список."

#: src/Connection.php:66
msgid "Connection requires HTTPS for the site and admin on the same domain, sodium, and WordPress security keys in wp-config.php."
msgstr "Для подключения нужны HTTPS сайта и админки на одном домене, sodium и ключи безопасности WordPress в wp-config.php."

#: src/Connection.php:75
msgid "Start the connection again from the WordPress admin."
msgstr "Повторите подключение из админки WordPress."

#: src/Plugin.php:37
msgid "Dzen Chat: every minute"
msgstr "Dzen Chat: каждую минуту"

#: src/Plugin.php:44
msgid "Connect Dzen Chat separately for each site. Network activation is not supported yet."
msgstr "Подключайте Dzen Chat отдельно для каждого сайта. Сетевая активация пока не поддерживается."

