msgstr "Триггеры страницы доступны для публичных страниц и записей."

#: src/PageIndex.php:76
msgid "Only published pages and posts are sent for indexing."
msgstr "На индексацию отправляются только опубликованные страницы и записи."

#: src/PageIndex.php:77
msgid "Password-protected content is not sent for indexing."
msgstr "Содержимое, защищённое паролем, не отправляется на индексацию."

#: src/PageIndex.php:78
