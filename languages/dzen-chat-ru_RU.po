#. Plugin Name of the plugin
#: dzen-chat.php src/Admin.php:391
msgid "Dzen Chat"
msgstr "Dzen Chat"

#. Description of the plugin
#: dzen-chat.php
msgid ""
"Connect Dzen Chat, manage widgets, sync public content and view "
"conversations."
msgstr ""
"Подключите Dzen Chat, управляйте виджетами, синхронизируйте публичный "
"контент и просматривайте диалоги."

#. Author of the plugin
#: dzen-chat.php
msgid "Dzen Platform"
msgstr "Dzen Platform"

#: src/Admin.php:32
msgid "Overview"
msgstr "Обзор"

#: src/Admin.php:32 src/Admin.php:423
msgid "Widgets"
msgstr "Виджеты"

#: src/Admin.php:33 src/Admin.php:265
msgid "Index"
msgstr "Индекс"

#: src/Admin.php:33 src/Admin.php:344
msgid "Conversations"
msgstr "Диалоги"

#: src/Admin.php:54
msgid "The filter is too long."
msgstr "Слишком длинный фильтр."

#: src/Admin.php:59
msgid "Enter a date in YYYY-MM-DD format."
msgstr "Укажите дату в формате ГГГГ-ММ-ДД."

#: src/Admin.php:65
msgid "The start date must be on or before the end date."
msgstr "Начальная дата должна быть не позже конечной."

#: src/Admin.php:102 src/Connection.php:26
msgid "You do not have permission to perform this action."
msgstr "Недостаточно прав."

#: src/Admin.php:106
msgid "Authorization complete. Public pages will be submitted for reindexing."
msgstr ""
"Авторизация завершена. Публичные страницы будут отправлены на переиндексацию."

#: src/Admin.php:107
msgid ""
"Credentials removed from WordPress. Open Dzen Chat to revoke the API client."
msgstr "Ключи удалены из WordPress. Для отзыва API-клиента откройте Dzen Chat."

#: src/Admin.php:108
msgid "Connection cancelled."
msgstr "Подключение отменено."

#: src/Admin.php:109
msgid "Connection was not completed. Start again."
msgstr "Подключение не завершено. Начните его заново."

#: src/Admin.php:110
msgid "Change saved."
msgstr "Изменение сохранено."

#: src/Admin.php:111
msgid "Widget created. Select it below to display it on this site."
msgstr "Виджет создан. Выберите его в списке, чтобы показывать на этом сайте."

#: src/Admin.php:112
msgid "Request accepted. Check processing progress in the Index section."
msgstr "Запрос принят. Статус обработки можно посмотреть в разделе «Индекс»."

#: src/Admin.php:113
msgid "Document uploaded. Check its indexing status below."
msgstr "Документ загружен. Проверьте статус его индексации ниже."

#: src/Admin.php:114
msgid "Public content reconciliation has been queued."
msgstr "Сверка публичных страниц поставлена в очередь."

#: src/Admin.php:119
msgid "Connect this site to an existing or new Dzen Chat project."
msgstr "Подключите сайт к существующему или новому проекту Dzen Chat."

#: src/Admin.php:120
msgid "Connect Dzen Chat"
msgstr "Подключить Dzen Chat"

#: src/Admin.php:131
msgid ""
"The site URL, service URL or security keys have changed. Reconnect the site."
msgstr ""
"Адрес сайта, сервис или ключи безопасности изменились. Подключите сайт "
"заново."

#: src/Admin.php:132 src/Admin.php:158
msgid "Reconnect"
msgstr "Подключить заново"

#: src/Admin.php:140
msgid "This site is connected to Dzen Chat"
msgstr "Сайт авторизован в Dzen Chat"

#: src/Admin.php:145
msgid "Service access confirmed."
msgstr "Доступ к сервису подтверждён."

#: src/Admin.php:149
msgid "Site source:"
msgstr "Источник сайта:"

#: src/Admin.php:152
msgid "The site source is no longer available to this connection."
msgstr "Источник сайта больше не доступен этому подключению."

#: src/Admin.php:155
msgid "Manage widgets"
msgstr "Настроить виджеты"

#: src/Admin.php:156 src/Admin.php:457
msgid "Open Dzen Chat ↗"
msgstr "Открыть Dzen Chat ↗"

#: src/Admin.php:159
msgid "Remove credentials from WordPress"
msgstr "Удалить ключи из WordPress"

#: src/Admin.php:160
msgid "Public page and post updates"
msgstr "Обновление публичных страниц и записей"

#: src/Admin.php:165
msgid "Waiting to be sent"
msgstr "Ожидает отправки"

#: src/Admin.php:165
msgid "Submitted to the service"
msgstr "Передано сервису"

#: src/Admin.php:166
msgid "Cancelled by indexing exclusion"
msgstr "Отменено из-за исключения из индекса"

#: src/Admin.php:167 src/PageIndex.php:104 src/PageIndex.php:130
msgid "Excluded from indexing"
msgstr "Исключена из индексации"

#: src/Admin.php:168
msgid "Waiting for access"
msgstr "Ожидает доступа"

#: src/Admin.php:168
msgid "Submission failed"
msgstr "Ошибка отправки"

#: src/Admin.php:171
msgid ""
"An accepted request does not mean indexing is complete. Check processing "
"results in the Index section."
msgstr ""
"Принятый запрос ещё не означает завершённую индексацию. Результат обработки "
"отображается в разделе «Индекс»."

#: src/Admin.php:172
msgid ""
"Could not save the event. Check the connection and WordPress database, then "
"run reconciliation."
msgstr ""
"Не удалось записать событие. Проверьте подключение и базу WordPress, затем "
"запустите сверку."

#: src/Admin.php:173
msgid "Reconcile content and retry failed requests"
msgstr "Сверить контент и повторить ошибки"

#: src/Admin.php:174
msgid ""
"The WordPress scheduler runs these jobs. Products, drafts and password-"
"protected posts are not submitted as public content."
msgstr ""
"Задания выполняет планировщик WordPress. Товары, черновики и защищённые "
"записи не отправляются как публичный контент."

#: src/Admin.php:175
msgid ""
"Billing status, hiding conversations, answer sources and page trigger "
"controls are not yet available in this integration."
msgstr ""
"Статус оплаты, скрытие диалогов, источники ответов и управление триггерами "
"страниц пока недоступны в этой версии интеграции."

#: src/Admin.php:181
msgid "The service returned an invalid source state."
msgstr "Сервис вернул некорректное состояние источника."

#: src/Admin.php:185
msgid "Processing restricted:"
msgstr "Обработка ограничена:"

#: src/Admin.php:187 src/Admin.php:223
msgid "Updates paused"
msgstr "Обновление приостановлено"

#: src/Admin.php:187
msgid "Updates allowed"
msgstr "Обновление разрешено"

#: src/Admin.php:189
msgid "Source triggers:"
msgstr "Триггеры источника:"

#: src/Admin.php:189
msgid "enabled"
msgstr "включены"

#: src/Admin.php:189
msgid "disabled"
msgstr "выключены"

#: src/Admin.php:190
msgid "Last reindexed:"
msgstr "Последняя переиндексация:"

#: src/Admin.php:195
msgid "Errors"
msgstr "Ошибки"

#: src/Admin.php:195
msgid "Pending"
msgstr "Ожидают обхода"

#: src/Admin.php:196 src/PageIndex.php:128
msgid "Processing"
msgstr "Обрабатывается"

#: src/Admin.php:196
msgid "Ready"
msgstr "Готово"

#: src/Admin.php:197
msgid "Excluded"
msgstr "Исключены"

#. Translators: %s is the total number of pages in this source.
#: src/Admin.php:222
#, php-format
msgid "%s page in this source."
msgid_plural "%s pages in this source."
msgstr[0] "В этом источнике %s страница."
msgstr[1] "В этом источнике %s страницы."
msgstr[2] "В этом источнике %s страниц."

#: src/Admin.php:224
msgid "Indexing is restricted. Open Dzen Chat for details."
msgstr "Индексация ограничена. Подробности доступны в Dzen Chat."

#: src/Admin.php:226
msgid "No pages have been discovered yet."
msgstr "Страницы пока не обнаружены."

#: src/Admin.php:227
msgid "All discovered pages are excluded from indexing."
msgstr "Все обнаруженные страницы исключены из индексации."

#: src/Admin.php:228
msgid "Excluded pages are counted separately from the progress bar."
msgstr "Исключённые страницы учитываются отдельно от индикатора прогресса."

#: src/Admin.php:229
msgid "Source settings in Dzen Chat ↗"
msgstr "Настройки источника в Dzen Chat ↗"

#: src/Admin.php:238
msgid ""
"The document is too large for indexing. Shorten it in Dzen Chat or upload a "
"smaller document."
msgstr ""
"Документ слишком большой для индексации. Сократите его в Dzen Chat или "
"загрузите документ меньшего размера."

#: src/Admin.php:245 src/Admin.php:283
msgid "Add a document"
msgstr "Добавить документ"

#: src/Admin.php:251
msgid "Document"
msgstr "Документ"

#. Translators: %s is the maximum upload size, such as 256 KB.
#: src/Admin.php:254
#, php-format
msgid "TXT or Markdown (.txt, .md, .markdown), UTF-8. Maximum file size: %s."
msgstr ""
"TXT или Markdown (.txt, .md, .markdown), UTF-8. Максимальный размер файла: "
"%s."

#: src/Admin.php:255
msgid ""
"Uploads go to Dzen Chat without being added to the WordPress media library."
msgstr ""
"Документы отправляются в Dzen Chat и не добавляются в медиатеку WordPress."

#: src/Admin.php:256
msgid "Upload for indexing"
msgstr "Загрузить для индексации"

#: src/Admin.php:258 src/Admin.php:500
msgid "You do not have permission to upload documents."
msgstr "У вас нет прав для загрузки документов."

#: src/Admin.php:273
msgid "Back to Index"
msgstr "Вернуться к индексу"

#: src/Admin.php:278 src/Admin.php:334
msgid "Edit document in Dzen Chat ↗"
msgstr "Редактировать документ в Dzen Chat ↗"

#: src/Admin.php:282
msgid ""
"Track this website, additional sources and uploaded documents in one place."
msgstr ""
"Следите за индексацией сайта, дополнительных источников и загруженных "
"документов на одной странице."

#: src/Admin.php:283 src/PageIndex.php:29
msgid "Refresh status"
msgstr "Обновить статус"

#: src/Admin.php:284
msgid "This WordPress site"
msgstr "Этот сайт WordPress"

#: src/Admin.php:286
msgid "Additional website sources"
msgstr "Дополнительные сайты"

#: src/Admin.php:294
msgid "The service returned an invalid source list."
msgstr "Сервис вернул некорректный список источников."

#: src/Admin.php:303
msgid "No additional website sources are available to this connection."
msgstr "Для этого подключения нет доступных дополнительных сайтов."

#: src/Admin.php:314
msgid "Manage sources in Dzen Chat ↗"
msgstr "Управление источниками в Dzen Chat ↗"

#: src/Admin.php:317
msgid "Uploaded documents"
msgstr "Загруженные документы"

#: src/Admin.php:322
msgid "No files have been added."
msgstr "Файлы не добавлены."

#. Translators: %s is the total number of uploaded documents.
#: src/Admin.php:328
#, php-format
msgid "%s uploaded document."
msgid_plural "%s uploaded documents."
msgstr[0] "%s загруженный документ."
msgstr[1] "%s загруженных документа."
msgstr[2] "%s загруженных документов."

#: src/Admin.php:344
msgid "Conversations are stored in Dzen Chat."
msgstr "Переписка хранится в Dzen Chat."

#: src/Admin.php:351
msgid ""
"Filters apply to the 100 most recent conversations. Full history text search "
"and hiding conversations are not yet available."
msgstr ""
"Фильтры применяются к 100 последним диалогам. Поиск по тексту всей истории и "
"скрытие пока недоступны."

#: src/Admin.php:353
msgid "Conversation or visitor ID"
msgstr "ID диалога или посетителя"

#: src/Admin.php:354
msgid "From date (UTC)"
msgstr "С даты (UTC)"

#: src/Admin.php:354
msgid "To date (UTC)"
msgstr "По дату (UTC)"

#: src/Admin.php:357 src/Admin.php:442 src/Plugin.php:142
msgid "Widget"
msgstr "Виджет"

#: src/Admin.php:357
msgid "All widgets"
msgstr "Все виджеты"

#: src/Admin.php:362
msgid "Apply"
msgstr "Применить"

#: src/Admin.php:370
msgid "No results in the loaded set."
msgstr "В загруженном наборе ничего не найдено."

#: src/Admin.php:371
msgid "Conversation"
msgstr "Диалог"

#: src/Admin.php:371 src/Admin.php:391
msgid "Visitor"
msgstr "Посетитель"

#: src/Admin.php:371
msgid "Created (UTC)"
msgstr "Создан (UTC)"

#: src/Admin.php:380
msgid "All conversations"
msgstr "Все диалоги"

#: src/Admin.php:384
msgid "Open conversation in Dzen Chat ↗"
msgstr "Открыть диалог в Dzen Chat ↗"

#: src/Admin.php:388
msgid ""
"The first 100 messages have been loaded. Open Dzen Chat to view the rest."
msgstr ""
"Получены первые 100 сообщений. Продолжение пока доступно только в Dzen Chat."

#: src/Admin.php:392
msgid "Helpful answer"
msgstr "Полезный ответ"

#: src/Admin.php:392
msgid "Unhelpful answer"
msgstr "Ответ не помог"

#: src/Admin.php:394
msgid "Suggestions"
msgstr "Подсказки"

#: src/Admin.php:400
msgid "Selected by visitor"
msgstr "Выбрано посетителем"

#: src/Admin.php:405
msgid ""
"Suggestions could not be generated for this answer. Open this conversation "
"in Dzen Chat for details."
msgstr ""
"Не удалось создать подсказки для этого ответа. Подробности доступны в этом "
"диалоге в Dzen Chat."

#: src/Admin.php:407
msgid "No suggestions were saved for this answer."
msgstr "Для этого ответа нет сохранённых подсказок."

#: src/Admin.php:418
msgid "Open original ↗"
msgstr "Открыть оригинал ↗"

#: src/Admin.php:427 src/Admin.php:434
msgid "Refresh list"
msgstr "Обновить список"

#: src/Admin.php:428
msgid "Connection settings"
msgstr "Настройки подключения"

#: src/Admin.php:432
msgid ""
"Choose the widget to display across this site. Edit its appearance, messages "
"and other settings in Dzen Chat."
msgstr ""
"Выберите виджет для показа на сайте. Оформление, сообщения и другие "
"настройки редактируются в Dzen Chat."

#: src/Admin.php:433
msgid "Add widget"
msgstr "Добавить виджет"

#: src/Admin.php:436
msgid ""
"The previously selected widget is no longer available. Select another widget "
"for this site."
msgstr ""
"Выбранный ранее виджет больше недоступен. Выберите другой виджет для сайта."

#: src/Admin.php:441
msgid "Available project widgets"
msgstr "Доступные виджеты проекта"

#: src/Admin.php:442
msgid "On site"
msgstr "На сайте"

#: src/Admin.php:442
msgid "Status"
msgstr "Статус"

#: src/Admin.php:444
msgid "No widgets yet. Add your first widget below."
msgstr "Виджетов пока нет. Добавьте первый виджет ниже."

#: src/Admin.php:452
msgid "Selected for this site"
msgstr "Выбран для этого сайта"

#: src/Admin.php:455
msgid "Edit in Dzen Chat ↗"
msgstr "Настроить в Dzen Chat ↗"

#: src/Admin.php:459
msgid "Enabled in Dzen Chat"
msgstr "Включён в Dzen Chat"

#: src/Admin.php:459
msgid "Disabled in Dzen Chat — hidden on the site"
msgstr "Выключен в Dzen Chat — не показывается на сайте"

#: src/Admin.php:460
msgid "Enable it in Dzen Chat before selecting it."
msgstr "Перед выбором включите виджет в Dzen Chat."

#: src/Admin.php:463
msgid "No site-wide widget"
msgstr "Не показывать общий виджет на сайте"

#: src/Admin.php:464
msgid ""
"In the page or post editor, you can select another widget or hide it on that "
"page."
msgstr ""
"В редакторе страницы или записи можно выбрать другой виджет либо скрыть его "
"на этой странице."

#: src/Admin.php:465
msgid "Save selection"
msgstr "Сохранить выбор"

#: src/Admin.php:466
msgid "Open site to check the widget"
msgstr "Открыть сайт и проверить виджет"

#: src/Admin.php:467
msgid "Help on 404 pages"
msgstr "Помощь на страницах 404"

#: src/Admin.php:471
msgid "Show chat on 404 pages"
msgstr "Показывать чат на страницах 404"

#: src/Admin.php:472
msgid ""
"Use the selected site-wide widget to invite visitors to ask for help when a "
"page is not found. The chat opens when they choose Start a conversation. Off "
"by default."
msgstr ""
"Если страница не найдена, предложить посетителю помощь через выбранный для "
"сайта виджет. Чат откроется по кнопке «Начать диалог». По умолчанию "
"выключено."

#: src/Admin.php:474
msgid ""
"Select an enabled site-wide widget above to make chat available on 404 pages."
msgstr ""
"Выберите выше включённый виджет для сайта, чтобы чат был доступен на "
"страницах 404."

#: src/Admin.php:476
msgid "Save 404 settings"
msgstr "Сохранить настройки 404"

#: src/Admin.php:477
msgid "Create widget"
msgstr "Создать виджет"

#: src/Admin.php:479
msgid "Name"
msgstr "Название"

#: src/Admin.php:479
msgid "Create"
msgstr "Создать"

#: src/Admin.php:480
msgid ""
"The new widget is added to this project. Configure it in Dzen Chat, then "
"select it for this site."
msgstr ""
"Новый виджет появится в этом проекте. Настройте его в Dzen Chat, затем "
"выберите для показа на сайте."

#: src/Admin.php:481
msgid ""
"Before enabling the widget, remove any manually added Dzen Chat script to "
"prevent it from loading twice."
msgstr ""
"Перед включением уберите ранее вставленный вручную скрипт Dzen Chat, чтобы "
"виджет не загружался дважды."

#: src/Admin.php:490 src/PageIndex.php:85 src/Plugin.php:136 src/Sync.php:126
msgid "Reconnect the site in the Dzen Chat section."
msgstr "Подключите сайт заново в разделе Dzen Chat."

#: src/Admin.php:520
msgid "This page does not belong to this site's source."
msgstr "Страница не относится к источнику этого сайта."

#: src/Admin.php:528
msgid "Select a widget or choose no site-wide widget."
msgstr "Выберите виджет или вариант без общего виджета на сайте."

#: src/Admin.php:534
msgid "Enable the widget before placing it on the site."
msgstr "Сначала включите виджет, затем разместите его на сайте."

#: src/Admin.php:546
msgid "Enter a widget name."
msgstr "Укажите название виджета."

#: src/Admin.php:553
msgid "Unknown action."
msgstr "Неизвестное действие."

#: src/Api.php:33
msgid "Could not exchange the code. Start the connection again."
msgstr "Не удалось обменять код. Начните подключение заново."

#: src/Api.php:38
msgid ""
"Dzen Chat did not confirm the code exchange. Start the connection again."
msgstr "Dzen Chat не подтвердил обмен кода. Начните подключение заново."

#: src/Api.php:48
msgid "Conversation history is read-only in this version."
msgstr "В этой версии доступен только просмотр истории чатов."

#: src/Api.php:67
msgid ""
"Check the connection and WordPress security keys. Reconnect if the site URL "
"has changed."
msgstr ""
"Проверьте подключение и ключи WordPress. При смене адреса сайта подключите "
"его заново."

#: src/Api.php:70
msgid "Dzen Chat is unavailable. The service has not confirmed the change."
msgstr "Dzen Chat недоступен. Изменение не подтверждено сервисом."

#: src/Api.php:77 src/Api.php:82
msgid "Check the values you entered."
msgstr "Проверьте введённые данные."

#: src/Api.php:78
msgid "Reconnect the site to Dzen Chat."
msgstr "Нужно повторно подключить сайт к Dzen Chat."

#: src/Api.php:79
msgid ""
"This action is unavailable. Check permissions and the project status in Dzen "
"Chat."
msgstr "Действие недоступно: проверьте права и состояние проекта в Dzen Chat."

#: src/Api.php:80
msgid "The item is unavailable or the API does not support this operation yet."
msgstr "Объект недоступен или API ещё не поддерживает эту операцию."

#: src/Api.php:81
msgid "The state has changed. Refresh the page and try again."
msgstr "Состояние изменилось. Обновите страницу и повторите действие."

#: src/Api.php:83
msgid "Too many requests. Try again later."
msgstr "Слишком много запросов. Повторите позже."

#: src/Api.php:88
msgid "The service did not confirm the operation. Try again later."
msgstr "Сервис не подтвердил операцию. Попробуйте позднее."

#: src/Api.php:93
msgid "Dzen Chat returned an invalid response. The operation is not confirmed."
msgstr "Dzen Chat вернул некорректный ответ. Операция не подтверждена."

#: src/Api.php:119 src/Api.php:132 src/Api.php:159 src/Api.php:210
msgid "Invalid public page URL."
msgstr "Некорректный публичный адрес страницы."

#: src/Api.php:124
msgid "The service did not confirm the reindexing request."
msgstr "Сервис не подтвердил запрос переиндексации."

#: src/Api.php:137
msgid "The service did not confirm removal from the index."
msgstr "Сервис не подтвердил удаление из индекса."

#: src/Api.php:150
msgid "The service returned an invalid list."
msgstr "Сервис вернул некорректный список."

#: src/Api.php:167
msgid "The service returned an invalid page status."
msgstr "Сервис вернул некорректный статус страницы."

#: src/Api.php:177
msgid "The service returned an invalid indexing status."
msgstr "Сервис вернул некорректный статус индексации."

#: src/Api.php:202
